#!/bin/bash
# Adapted from the ebusd project, GPL-3.0:
#   https://github.com/john30/ebusd/blob/master/contrib/scripts/ebusctl (master, fetched 2026-11-22)
# Local changes, marked "LOCAL":
#   - plain-bash option parsing and bash's /dev/tcp instead of getopt and nc, so it runs unchanged on
#     Linux and macOS (BSD getopt has no long options, macOS nc has no -q); needs only bash >= 3.2;
#   - the default host/port come from the git-ignored config file next to this skill;
#   - the host, its addresses and the port are masked in all output; connect errors are generic.
# ebusctl - tool for accessing ebusd via TCP.
# this can either pass excess arguments to ebusd and then quit,
# or run interactively if no excess arguments were given.

# print help
help() {
  cat << EOF
Usage: ebusctl [OPTION...] [--] [COMMAND...]
Client for accessing ebusd via TCP.

 Options:
  -s, --server=HOST   Connect to ebusd on HOST (name or IP) [localhost]
  -p, --port=PORT     Connect to ebusd on PORT [8888]
  -t, --timeout=SECS  Timeout for connecting to/receiving from ebusd, 0 for
                      none [60]
  -e, --error         Exit non-zero if the connection was fine but the response
                      indicates non-success
        [COMMAND...]  COMMAND (and arguments) to send to ebusd.

If given, send COMMAND together with arguments to ebusd.
Use 'help' as COMMAND for help on available ebusd commands.
EOF
}

server=localhost
port=8888
# LOCAL: override the defaults from the git-ignored .ebusctl.conf next to this skill (host=, port=
# lines; parsed, never sourced, so the file cannot run code). -s / -p below still win.
conf="$(dirname "${BASH_SOURCE[0]}")/../.ebusctl.conf"
if [ -r "$conf" ]; then
  while IFS='=' read -r key value || [ -n "$key" ]; do
    value="${value%%#*}"; value="${value//[[:space:]]/}"; key="${key//[[:space:]]/}"
    case "$key" in
      host) [ -n "$value" ] && server="$value" ;;
      port) [ -n "$value" ] && port="$value" ;;
    esac
  done < "$conf"
fi
timeout=60
error=

# LOCAL: parse options in plain bash (no getopt). Stops at `--` or at the first non-option, so the
# ebusd command's own flags (`read -f`) are passed through untouched.
need_arg() {
  if [ "$2" -lt 2 ]; then
    echo "ebusctl: option requires an argument -- '$1'" >&2
    help
    exit 1
  fi
}
while [ $# -gt 0 ]; do
  case "$1" in
    -s|--server)  need_arg "$1" $#; server="$2"; shift 2 ;;
    --server=*)   server="${1#*=}"; shift ;;
    -p|--port)    need_arg "$1" $#; port="$2"; shift 2 ;;
    --port=*)     port="${1#*=}"; shift ;;
    -t|--timeout) need_arg "$1" $#; timeout="$2"; shift 2 ;;
    --timeout=*)  timeout="${1#*=}"; shift ;;
    -e|--error)   error=1; shift ;;
    -h|--help)    help; exit ;;
    --)           shift; break ;;
    -*)           echo "ebusctl: invalid option -- '$1'" >&2; help; exit 1 ;;
    *)            break ;;
  esac
done
if [ -z "$server" ]; then
  echo "invalid server" >&2
  exit 1
fi
case "$port" in ''|*[!0-9]*) echo "invalid port" >&2; exit 1 ;; esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
  echo "invalid port" >&2
  exit 1
fi
case "$timeout" in ''|*[!0-9]*) echo "invalid timeout" >&2; exit 1 ;; esac
if [ "$timeout" -gt 3600 ]; then
  echo "invalid timeout" >&2
  exit 1
fi

# LOCAL: mask the host, the addresses it resolves to and "port N" in every output line, so a
# caller (an agent) never sees where ebusd runs. Literal matches (quoted ${//}), not regexes.
# getent exists on Linux only; on macOS the host name itself is still masked.
masks=("$server")
if command -v getent >/dev/null 2>&1; then
  while read -r ip _; do masks+=("$ip"); done < <(getent ahosts "$server" 2>/dev/null | sort -u -k1,1)
fi
redact_line() {
  local m
  out="$1"
  for m in "${masks[@]}"; do [ -n "$m" ] && out="${out//"$m"/<ebusd-host>}"; done
  out="${out//"port $port"/port <ebusd-port>}"
}
redact() {
  local l
  while IFS= read -r l || [ -n "$l" ]; do
    redact_line "$l"
    printf '%s\n' "$out"
  done
}

# LOCAL: watchdog for the whole non-interactive call (bash's /dev/tcp has no connect timeout).
# It sends TERM to this script after $timeout seconds; its own sleep is killed when it is.
watchdog=
start_watchdog() {
  [ "$timeout" -gt 0 ] || return
  (
    sleep "$timeout" </dev/null >/dev/null 2>&1 &
    s=$!
    trap 'kill "$s" 2>/dev/null; exit 0' TERM
    wait "$s" && kill -TERM $$ 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  watchdog=$!
}
trap 'echo "ERR: timeout talking to ebusd" >&2; exit 1' TERM
trap '[ -n "$watchdog" ] && kill "$watchdog" 2>/dev/null' EXIT

# LOCAL: connect with bash's /dev/tcp; the shell's own error names host and port, so hide it.
# fd 9, not 3: on macOS the host-name lookup leaves a guarded network-policy fd on 3, and dup'ing
# the socket onto it gets bash SIGKILLed (EXC_GUARD). bash 3.2 has no {fd} auto-allocation.
connect() {
  if ! { exec 9<>"/dev/tcp/$server/$port"; } 2>/dev/null; then
    echo "ERR: cannot connect to ebusd" >&2
    exit 1
  fi
}

# check interactive mode
if [ $# -ne 0 ]; then
  # non-interactive mode: send one line, print the answer up to ebusd's terminating empty line
  start_watchdog
  connect
  printf '%s\n' "$*" >&9
  readopts=(-r -u 9)
  [ "$timeout" -gt 0 ] && readopts+=(-t "$timeout")
  ret=0
  while IFS= read "${readopts[@]}" line; do
    line="${line%$'\r'}"
    [ -z "$line" ] && break
    redact_line "$line"
    echo "$out"
    if [ -n "$error" ] && [ "${line##ERR:}" != "$line" ]; then
      ret=1
    fi
  done
  exec 9<&-
  exit $ret
fi

# interactive mode
echo "entering interactive mode" >&2
connect
redact <&9 &
reader=$!
cat >&9
exec 9<&-
kill "$reader" 2>/dev/null
